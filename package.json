{
  "name": "tmdb-kit",
  "type": "module",
  "version": "1.3.0",
  "description": "A tiny, typed, zero-runtime-dependency TMDB SDK and CLI for Node.js, Bun, Deno, and edge runtimes.",
  "author": "isaced",
  "license": "MIT",
  "homepage": "https://github.com/isaced/tmdb-kit#readme",
  "keywords": [
    "tmdb",
    "themoviedb",
    "sdk",
    "typescript",
    "node",
    "bun",
    "cli",
    "deno",
    "edge",
    "esm",
    "cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaced/tmdb-kit.git"
  },
  "bugs": {
    "url": "https://github.com/isaced/tmdb-kit/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tmdb": "./dist/cli.js",
    "tmdb-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:cli": "bun run scripts/build.ts --cli",
    "cli": "bun run build:cli && bun ./dist/cli.js",
    "dev": "bun build ./src/index.ts --outdir ./dist --entry-naming '[name].js' --format esm --target browser --sourcemap=linked --watch",
    "test": "bun test --isolate tests/unit tests/resources tests/cli",
    "test:resources": "bun test --isolate tests/resources",
    "test:unit": "bun test --isolate tests/unit",
    "test:watch": "bun test --isolate --watch tests/unit tests/resources tests/cli",
    "test:coverage": "bun test --isolate --coverage tests/unit tests/resources tests/cli",
    "test:integration": "bun test --isolate tests/integration",
    "typecheck": "bun check",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "ci": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build",
    "release": "bumpp",
    "prepublishOnly": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^25.6.2",
    "bumpp": "^11.1.0",
    "citty": "^0.2.2",
    "typescript": "^6.0.3"
  }
}
